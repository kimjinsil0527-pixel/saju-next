# Public site URL
NEXT_PUBLIC_SITE_URL=https://sajuunmyung.com

# Supabase values are intentionally blank in this template.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication and webhook secrets
AUTH_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_ENVIRONMENT=test

# Lemon Squeezy product verification.
# Variant IDs and checkout URLs are not passwords, but keeping them in server
# configuration lets the webhook use one trusted product catalog.
LEMONSQUEEZY_MONTHLY_CHECKOUT_URL=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_COOKIE_PACK_CHECKOUT_URL=
LEMONSQUEEZY_COOKIE_20_VARIANT_ID=
LEMONSQUEEZY_COOKIE_40_VARIANT_ID=
LEMONSQUEEZY_COOKIE_80_VARIANT_ID=
LEMONSQUEEZY_CUSTOMER_PORTAL_URL=

# Creem product IDs are not passwords. Test products can use these IDs while
# CREEM_ENVIRONMENT=test. Replace them with live product IDs before live sales.
CREEM_MONTHLY_PRODUCT_ID=prod_1iR4fUUpekZZqoZwkcqXn9
CREEM_COOKIE_20_PRODUCT_ID=prod_6h7sy1qzQLppQQaVhW8V0t
CREEM_COOKIE_40_PRODUCT_ID=prod_7hERfSFCZcY3G0see9Ysai
CREEM_COOKIE_80_PRODUCT_ID=prod_3lzVufPTg3G8puKvpG6j90
CREEM_CUSTOMER_PORTAL_URL=
