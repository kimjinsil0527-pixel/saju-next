# Public site URL
NEXT_PUBLIC_SITE_URL=https://sajuunmyung.com

# Supabase values are intentionally blank in this template.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication and webhook secrets
AUTH_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy product verification.
# Variant IDs and checkout URLs are not passwords, but keeping them in server
# configuration lets the webhook use one trusted product catalog.
LEMONSQUEEZY_MONTHLY_CHECKOUT_URL=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_COOKIE_PACK_CHECKOUT_URL=
LEMONSQUEEZY_COOKIE_20_VARIANT_ID=
LEMONSQUEEZY_COOKIE_40_VARIANT_ID=
LEMONSQUEEZY_COOKIE_80_VARIANT_ID=
LEMONSQUEEZY_CUSTOMER_PORTAL_URL=
